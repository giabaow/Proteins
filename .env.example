# Anthropic API key, used by the agent to extract structured facts from raw text
ANTHROPIC_API_KEY=your_key_here


# Required by SEC for fetching EDGAR filings. Use your real contact email.
SEC_USER_AGENT=Proteins1Research your-email@example.com

# Default Opportunity Index weights (must sum to 1.0). Overridable per-request from the UI.
OI_WEIGHT_UNMET_NEED=0.3
OI_WEIGHT_SENSITIVITY_GAIN=0.2
OI_WEIGHT_MARKET=0.3
OI_WEIGHT_REGULATORY_BURDEN=0.2
